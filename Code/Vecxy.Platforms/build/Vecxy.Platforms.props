<Project>
  <PropertyGroup>
    <VecxyPlatform Condition="'$(VecxyPlatform)' == ''">Desktop</VecxyPlatform>
    <TargetFramework Condition="'$(VecxyPlatform)' == 'Desktop'">net10.0</TargetFramework>
    <TargetFramework Condition="'$(VecxyPlatform)' == 'Android'">net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\Vecxy.Platforms.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(VecxyPlatform)' == 'Desktop'">
    <Content Include="$(MSBuildProjectDirectory)\Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Assets\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
    <Content Include="$(MSBuildProjectDirectory)\Assets.manifest" Condition="Exists('$(MSBuildProjectDirectory)\Assets.manifest')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Assets.manifest</TargetPath>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="'$(VecxyPlatform)' == 'Android' and Exists('$(MSBuildProjectDirectory)\Assets.manifest')">
    <AndroidAsset Include="$(MSBuildProjectDirectory)\Assets.manifest">
      <Link>Assets.manifest</Link>
    </AndroidAsset>
  </ItemGroup>
  <ItemGroup Condition="'$(VecxyPlatform)' == 'Android' and '$(VecxyPackagesDirectory)' != '' and Exists('$(VecxyPackagesDirectory)')">
    <AndroidAsset Remove="$(MSBuildProjectDirectory)\Assets\**\*" />
    <AndroidAsset Include="$(VecxyPackagesDirectory)\**\*">
      <Link>Packages\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </AndroidAsset>
  </ItemGroup>
  <ItemGroup Condition="'$(VecxyPlatform)' == 'Desktop' and '$(VecxyPackagesDirectory)' != '' and Exists('$(VecxyPackagesDirectory)')">
    <Content Remove="$(MSBuildProjectDirectory)\Assets\**\*" />
    <Content Include="$(VecxyPackagesDirectory)\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Assets\Packages\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>

  <Import
    Project="$(MSBuildThisFileDirectory)..\..\Vecxy.Platforms.Android\build\Vecxy.Platforms.Android.props"
    Condition="'$(VecxyPlatform)' == 'Android'" />

  <Import Project="$(MSBuildThisFileDirectory)..\Vecxy.AtlasCompiler.targets" />

  <PropertyGroup>
    <VecxyCliProject>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\tools\Vecxy.Cli\Vecxy.Cli.csproj'))</VecxyCliProject>
  </PropertyGroup>

  <!-- Every build surface, including ./build release and Android publish, receives
       an up-to-date manifest/generated API and fails before packaging missing assets. -->
  <Target
    Name="VecxyPrepareAssets"
    BeforeTargets="PrepareForBuild"
    Condition="'$(VecxySkipAssetPipeline)' != 'true' and Exists('$(MSBuildProjectDirectory)\Assets') and Exists('$(VecxyCliProject)')">
    <Message Text="Vecxy: preparing assets for $(MSBuildProjectName)" Importance="high" />
    <Exec Command="dotnet run --project &quot;$(VecxyCliProject)&quot; -- --project &quot;$(MSBuildProjectDirectory)&quot; assets prepare" />
  </Target>
</Project>
