<Project>
  <PropertyGroup>
    <VecxyPlatform Condition="'$(VecxyPlatform)' == ''">Desktop</VecxyPlatform>
    <TargetFramework Condition="'$(VecxyPlatform)' == 'Desktop'">net10.0</TargetFramework>
    <TargetFramework Condition="'$(VecxyPlatform)' == 'Android'">net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <VecxyBuildVPack Condition="'$(VecxyBuildVPack)' == '' and '$(Configuration)' == 'Release'">true</VecxyBuildVPack>
    <VecxyBuildVPack Condition="'$(VecxyBuildVPack)' == ''">false</VecxyBuildVPack>
    <_VecxyVPackPlatform Condition="'$(VecxyPlatform)' == 'Android'">android</_VecxyVPackPlatform>
    <_VecxyVPackOutputPlatform Condition="'$(VecxyPlatform)' == 'Android'">Android</_VecxyVPackOutputPlatform>
    <_VecxyVPackPlatform Condition="'$(VecxyPlatform)' == 'Desktop' and $([MSBuild]::IsOSPlatform('Windows'))">windows</_VecxyVPackPlatform>
    <_VecxyVPackOutputPlatform Condition="'$(VecxyPlatform)' == 'Desktop' and $([MSBuild]::IsOSPlatform('Windows'))">Windows</_VecxyVPackOutputPlatform>
    <_VecxyVPackPlatform Condition="'$(VecxyPlatform)' == 'Desktop' and $([MSBuild]::IsOSPlatform('Linux'))">linux</_VecxyVPackPlatform>
    <_VecxyVPackOutputPlatform Condition="'$(VecxyPlatform)' == 'Desktop' and $([MSBuild]::IsOSPlatform('Linux'))">Linux</_VecxyVPackOutputPlatform>
    <VecxyPackagesDirectory Condition="'$(VecxyPackagesDirectory)' == '' and '$(VecxyBuildVPack)' == 'true'">$(MSBuildProjectDirectory)\Build\$(_VecxyVPackOutputPlatform)</VecxyPackagesDirectory>
    <!-- VPack currently stores the existing runtime-importer payload. Do not run the
         legacy loose-file atlas compiler after packaging or emit duplicate assets. -->
    <VecxyCompileAtlases Condition="'$(VecxyPackagesDirectory)' != ''">false</VecxyCompileAtlases>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\Vecxy.Platforms.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(VecxyPlatform)' == 'Desktop' and '$(VecxyBuildVPack)' != 'true'">
    <AssemblyMetadata Include="VecxyAssetsDirectory" Value="$(MSBuildProjectDirectory)/Assets" />
    <AssemblyMetadata Include="VecxyAdditionalAssetsDirectory" Value="$(MSBuildThisFileDirectory)../../Vecxy.Engine/Assets" />
  </ItemGroup>

  <ItemGroup Condition="'$(VecxyPlatform)' == 'Android' and Exists('$(MSBuildProjectDirectory)\Assets.manifest')">
    <AndroidAsset Include="$(MSBuildProjectDirectory)\Assets.manifest">
      <Link>Assets.manifest</Link>
    </AndroidAsset>
  </ItemGroup>
  <ItemGroup Condition="'$(VecxyPlatform)' == 'Android' and '$(VecxyPackagesDirectory)' != '' and Exists('$(VecxyPackagesDirectory)')">
    <AndroidAsset Remove="$(MSBuildProjectDirectory)\Assets\**\*" />
    <AndroidAsset Include="$(VecxyPackagesDirectory)\**\*" Exclude="$(VecxyPackagesDirectory)\Remote\**\*">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </AndroidAsset>
  </ItemGroup>
  <ItemGroup Condition="'$(VecxyPlatform)' == 'Desktop' and '$(VecxyPackagesDirectory)' != '' and Exists('$(VecxyPackagesDirectory)')">
    <Content Remove="$(MSBuildProjectDirectory)\Assets\**\*" />
    <Content Include="$(VecxyPackagesDirectory)\**\*" Exclude="$(VecxyPackagesDirectory)\Remote\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>

  <Import
    Project="$(MSBuildThisFileDirectory)..\..\Vecxy.Platforms.Android\build\Vecxy.Platforms.Android.props"
    Condition="'$(VecxyPlatform)' == 'Android'" />

  <Import Project="$(MSBuildThisFileDirectory)..\Vecxy.AtlasCompiler.targets" />

  <PropertyGroup>
    <VecxyCliProject>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\tools\Vecxy.Cli\Vecxy.Cli.csproj'))</VecxyCliProject>
    <VecxyCliArtifactsPath>$(MSBuildProjectDirectory)\obj\vecxy-cli-artifacts</VecxyCliArtifactsPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(VecxyBuildVPack)' == 'true'">
    <_VecxyVPackInput Include="$(MSBuildProjectDirectory)\Assets\**\*;$(MSBuildProjectDirectory)\Assets.manifest;$(MSBuildThisFileDirectory)..\..\Vecxy.Engine\Assets\**\*;$(MSBuildThisFileDirectory)..\..\..\tools\Vecxy.AssetPipeline\**\*.cs" />
  </ItemGroup>

  <!-- Every build surface, including ./build release and Android publish, receives
       an up-to-date manifest/generated API and fails before packaging missing assets. -->
  <Target
    Name="VecxyPrepareAssets"
    BeforeTargets="PrepareForBuild"
    Condition="'$(VecxySkipAssetPipeline)' != 'true' and '$(VecxyBuildVPack)' != 'true' and Exists('$(MSBuildProjectDirectory)\Assets') and Exists('$(VecxyCliProject)')">
    <Message Text="Vecxy: preparing assets for $(MSBuildProjectName)" Importance="high" />
    <Exec Command="dotnet run --project &quot;$(VecxyCliProject)&quot; -- --project &quot;$(MSBuildProjectDirectory)&quot; assets prepare" />
  </Target>

  <!-- Release builds from an IDE use the same production package stage as the
       project-local build wrappers. The CLI uses isolated artifacts so its desktop
       dependencies cannot overwrite an Android restore graph in shared obj folders. -->
  <Target
    Name="VecxyPackageAssets"
    BeforeTargets="AssignTargetPaths;PrepareForBuild"
    Inputs="@(_VecxyVPackInput)"
    Outputs="$(VecxyPackagesDirectory)\packages.manifest;$(VecxyPackagesDirectory)\packages.json"
    Condition="'$(VecxySkipAssetPipeline)' != 'true' and '$(VecxyBuildVPack)' == 'true' and Exists('$(MSBuildProjectDirectory)\Assets') and Exists('$(VecxyCliProject)')">
    <Error Condition="'$(_VecxyVPackPlatform)' == ''" Text="Vecxy VPack does not support the current build platform. Set VecxyBuildVPack=false or select windows, linux, or android." />
    <Message Text="Vecxy: building $(_VecxyVPackPlatform) VPack packages for $(MSBuildProjectName)" Importance="high" />
    <Exec Command="dotnet run --project &quot;$(VecxyCliProject)&quot; -p:UseArtifactsOutput=true -p:ArtifactsPath=&quot;$(VecxyCliArtifactsPath)&quot; -- --project &quot;$(MSBuildProjectDirectory)&quot; assets pack --platform $(_VecxyVPackPlatform)" />
    <ItemGroup Condition="'$(VecxyPlatform)' == 'Android'">
      <AndroidAsset Remove="$(MSBuildProjectDirectory)\Assets\**\*" />
      <AndroidAsset Remove="$(VecxyPackagesDirectory)\**\*" />
      <_VecxyBuiltPackage Include="$(VecxyPackagesDirectory)\**\*" Exclude="$(VecxyPackagesDirectory)\Remote\**\*" />
      <AndroidAsset
        Include="@(_VecxyBuiltPackage)"
        Link="%(_VecxyBuiltPackage.RecursiveDir)%(_VecxyBuiltPackage.Filename)%(_VecxyBuiltPackage.Extension)" />
    </ItemGroup>
    <ItemGroup Condition="'$(VecxyPlatform)' == 'Desktop'">
      <Content Remove="$(MSBuildProjectDirectory)\Assets\**\*" />
      <Content Remove="$(VecxyPackagesDirectory)\**\*" />
      <_VecxyBuiltPackage Include="$(VecxyPackagesDirectory)\**\*" Exclude="$(VecxyPackagesDirectory)\Remote\**\*" />
      <Content
        Include="@(_VecxyBuiltPackage)"
        CopyToOutputDirectory="PreserveNewest"
        TargetPath="%(_VecxyBuiltPackage.RecursiveDir)%(_VecxyBuiltPackage.Filename)%(_VecxyBuiltPackage.Extension)" />
    </ItemGroup>
  </Target>

  <Target
    Name="VecxyRestoreAndroidGraphAfterAssetTools"
    BeforeTargets="IncludeVecxySpriteAtlases;PrepareForBuild"
    DependsOnTargets="VecxyPackageAssets;CompileVecxySpriteAtlases"
    Condition="'$(VecxySkipAssetPipeline)' != 'true' and '$(VecxyBuildVPack)' == 'true' and '$(VecxyPlatform)' == 'Android'">
    <Message Text="Vecxy: restoring Android project graph after asset tools" Importance="high" />
    <Exec Command="dotnet restore &quot;$(MSBuildProjectFullPath)&quot; --runtime &quot;$(RuntimeIdentifier)&quot; -p:VecxyPlatform=Android -p:VecxySkipAssetPipeline=true" />
  </Target>

  <!-- Remove loose assets left by an older build layout. Production VPack files
       live beside the executable and are the only asset payload in Release. -->
  <Target
    Name="VecxyRemoveLegacyLooseAssetOutput"
    AfterTargets="Build"
    Condition="'$(VecxyPlatform)' == 'Desktop' and '$(VecxyBuildVPack)' == 'true' and Exists('$(TargetDir)Assets')">
    <RemoveDir Directories="$(TargetDir)Assets" />
  </Target>

  <!-- Development reads directly from the project tree. Remove files copied by
       older builds so bin/Debug cannot accidentally become a second asset root. -->
  <Target
    Name="VecxyRemoveCopiedDevelopmentAssets"
    AfterTargets="Build"
    Condition="'$(VecxyPlatform)' == 'Desktop' and '$(VecxyBuildVPack)' != 'true'">
    <RemoveDir Directories="$(TargetDir)Assets" Condition="Exists('$(TargetDir)Assets')" />
    <Delete Files="$(TargetDir)Assets.manifest;$(TargetDir)packages.manifest;$(TargetDir)packages.json" />
    <ItemGroup>
      <_VecxyStalePackage Include="$(TargetDir)*.vpack" />
    </ItemGroup>
    <Delete Files="@(_VecxyStalePackage)" />
  </Target>
</Project>
