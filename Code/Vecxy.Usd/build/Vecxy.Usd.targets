<Project>
  <PropertyGroup>
    <VecxyUsdPython Condition="'$(VecxyUsdPython)' == ''">python3</VecxyUsdPython>
  </PropertyGroup>
  <ItemGroup>
    <VecxyUsdStages Include="$(VecxyUsdStage)" Condition="'$(VecxyUsdStage)' != ''" />
  </ItemGroup>
  <Target Name="VecxyCookUsd" BeforeTargets="VecxyPrepareAssets;VecxyPackageAssets;PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true' and '@(VecxyUsdStages)' != ''">
    <Exec Command="&quot;$(VecxyUsdPython)&quot; &quot;$(MSBuildThisFileDirectory)../Tools/cook_usd.py&quot; &quot;%(VecxyUsdStages.FullPath)&quot; --assets &quot;$(MSBuildProjectDirectory)/Assets&quot;" />
  </Target>
</Project>
