<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework Condition="'$(VecxyPlatform)' == 'Desktop'">net10.0</TargetFramework>
        <TargetFramework Condition="'$(VecxyPlatform)' == 'Android' and '$(TargetFramework)' == ''">net10.0-android</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="StbImageSharp" Version="2.30.15" />
      <ProjectReference Include="..\Vecxy.Assets\Vecxy.Assets.csproj" />
      <ProjectReference Include="..\Vecxy.Audio\Vecxy.Audio.csproj" />
      <ProjectReference Include="..\Vecxy.Input\Vecxy.Input.csproj" />
      <ProjectReference Include="..\Vecxy.Kernel\Vecxy.Kernel.csproj" />
      <ProjectReference Include="..\Vecxy.Messaging\Vecxy.Messaging.csproj" />
      <ProjectReference Include="..\Vecxy.Physics\Vecxy.Physics.csproj" />
      <ProjectReference Include="..\Vecxy.Rendering\Vecxy.Rendering.csproj" />
      <ProjectReference Include="..\Vecxy.Scene\Vecxy.Scene.csproj" />
      <ProjectReference Include="..\Vecxy.Scripting\Vecxy.Scripting.csproj" />
      <ProjectReference Include="..\Vecxy.UI\Vecxy.UI.csproj" />
    </ItemGroup>
    
    <ItemGroup>
        <Content Include="Assets\**\*" Condition="'$(TargetPlatformIdentifier)' != 'android' and '$(VecxyPackagesDirectory)' == ''">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <TargetPath>Assets\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
        </Content>
        <EmbeddedResource Include="Assets\Textures\Logo.png" LogicalName="Vecxy.Engine.Splash.Logo.png" />
        <EmbeddedResource Include="Assets\Textures\FmodLogo.png" LogicalName="Vecxy.Engine.Splash.FmodLogo.png" />
    </ItemGroup>

    <!-- Android SDK treats a project's Assets directory as AndroidAsset by
         convention. Production game builds already carry these bytes in
         engine.vpack, so remove the implicit loose copy from the library. Debug
         keeps loose assets for the normal IDE development workflow. -->
    <ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'android' and '$(Configuration)' == 'Release'">
        <AndroidAsset Remove="Assets\**\*" />
        <Content Remove="Assets\**\*" />
    </ItemGroup>
</Project>
