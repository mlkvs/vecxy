<panel class="sidebar inspector">
  <panel class="panel-header"><text class="panel-title">Inspector</text></panel>
  <panel class="inspector-body">
    <text class="field-label">Name</text><input-field id="selection-name" class="field wide" placeholder="Slice name" max-length="128" />
    <text class="section-label">Rect</text><panel class="numeric-grid"><panel><text>X</text><input-field id="rect-x" class="field numeric"/></panel><panel><text>Y</text><input-field id="rect-y" class="field numeric"/></panel><panel><text>W</text><input-field id="rect-w" class="field numeric"/></panel><panel><text>H</text><input-field id="rect-h" class="field numeric"/></panel></panel>
    <text class="section-label">Pivot</text><panel class="numeric-grid"><panel><text>X</text><input-field id="pivot-x" class="field numeric"/></panel><panel><text>Y</text><input-field id="pivot-y" class="field numeric"/></panel></panel>
    <panel class="pivot-presets"><button id="pivot-tl">↖</button><button id="pivot-t">↑</button><button id="pivot-tr">↗</button><button id="pivot-l">←</button><button id="pivot-center">•</button><button id="pivot-r">→</button><button id="pivot-bl">↙</button><button id="pivot-bottom">↓</button><button id="pivot-br">↘</button></panel>
  </panel>
  <panel class="slices-header"><text class="panel-title">Slices</text><text id="slice-count" class="count">0</text></panel>
  <input-field id="slice-search" class="field search" placeholder="Search…"/>
  <panel id="slice-list" class="slice-list" virtualize="true" />
</panel>
